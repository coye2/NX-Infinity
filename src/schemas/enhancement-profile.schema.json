{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nx-api.invalid/schemas/enhancement-profile.schema.json",
  "title": "NX Enhancement Profile version 1",
  "description": "Typed review metadata. A schema-valid research template is not applicable. Runtime evaluation also verifies exact title/build/backend source, NX adapter version, SDK-verified installation manifest, hardware attestation, dependencies, conflicts, and explicit experimental selection. Legacy profiles without adapter/manifest fields remain readable but cannot authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "version", "displayName", "titleId", "buildId", "backendId", "backendRevision", "status", "source", "evidence", "originalBehavior", "rollbackNotes", "changes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/identifier" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "titleId": { "type": "string", "pattern": "^[0-9A-Fa-f]{16}$" },
    "buildId": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{64}$" },
    "backendId": { "$ref": "#/$defs/identifier" },
    "backendRevision": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
    "backendAdapterVersion": {
      "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$",
      "description": "Exact case-sensitive NX adapter version. Omitted/null legacy bindings remain readable but non-applicable."
    },
    "backendArtifactManifestSha256": {
      "type": ["string", "null"], "pattern": "^(?!0{64}$)[0-9A-Fa-f]{64}$",
      "description": "SHA256 of the exact installation manifest bytes validated by the SDK. This binds startup artifacts/compiler variants, not publisher trust, runtime driver behavior, or game qualification. Omitted/null is unbound."
    },
    "status": { "$ref": "#/$defs/status" },
    "hardware": { "anyOf": [{ "$ref": "#/$defs/hardware" }, { "type": "null" }] },
    "source": { "$ref": "#/$defs/source" },
    "evidence": { "$ref": "#/$defs/explanation" },
    "originalBehavior": { "$ref": "#/$defs/explanation" },
    "rollbackNotes": { "$ref": "#/$defs/explanation" },
    "dependsOn": { "$ref": "#/$defs/requirements" },
    "conflictsWith": { "$ref": "#/$defs/requirements" },
    "changes": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/change" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["experimental", "qualified"] } }, "required": ["status"] },
      "then": { "properties": {
        "titleId": { "type": "string", "pattern": "^(?!0{16}$)[0-9A-Fa-f]{16}$" },
        "buildId": { "type": "string", "pattern": "^(?!0{64}$)[0-9A-Fa-f]{64}$" }
      } }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "status": { "enum": ["research_candidate", "experimental", "qualified", "unsupported"] },
    "source": { "type": "string", "minLength": 1, "maxLength": 2048, "format": "uri", "pattern": "^https?://" },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "requirements": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([a-z0-9][a-z0-9._-]{0,95}|patch:[0-9A-Fa-f]{32})$" }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "vendorId": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{4}$" },
        "deviceId": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{4}$" },
        "driverVersions": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "deviceId": { "type": "string" } }, "required": ["deviceId"] },
          "then": { "required": ["vendorId"], "properties": { "vendorId": { "type": "string", "pattern": "^[0-9A-Fa-f]{4}$" } } }
        },
        {
          "anyOf": [
            { "required": ["vendorId"], "properties": { "vendorId": { "type": "string" } } },
            { "required": ["driverVersions"], "properties": { "driverVersions": { "minItems": 1 } } }
          ]
        }
      ]
    },
    "setting": {
      "type": "object", "additionalProperties": false, "required": ["settingId", "value"],
      "properties": {
        "settingId": { "$ref": "#/$defs/identifier" },
        "value": {
          "anyOf": [
            { "type": "boolean" }, { "type": "number" },
            { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._+-]+$" }
          ]
        }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["changeId", "kind", "status", "description", "source", "evidence"],
      "properties": {
        "changeId": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["settings", "game_patch", "unsupported_platform", "separately_supplied_content"] },
        "status": { "$ref": "#/$defs/status" },
        "description": { "$ref": "#/$defs/explanation" },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "$ref": "#/$defs/explanation" },
        "dependsOn": { "$ref": "#/$defs/requirements" },
        "conflictsWith": { "$ref": "#/$defs/requirements" },
        "setting": { "anyOf": [{ "$ref": "#/$defs/setting" }, { "type": "null" }] },
        "patchReceiptId": { "type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{32}$" },
        "contentId": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "settings" }, "status": { "enum": ["experimental", "qualified"] } }, "required": ["kind", "status"] },
          "then": { "required": ["setting"], "properties": { "setting": { "$ref": "#/$defs/setting" } } }
        },
        {
          "if": { "properties": { "kind": { "not": { "const": "settings" } } }, "required": ["kind"] },
          "then": { "properties": { "setting": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kind": { "not": { "const": "game_patch" } } }, "required": ["kind"] },
          "then": { "properties": { "patchReceiptId": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kind": { "not": { "const": "separately_supplied_content" } } }, "required": ["kind"] },
          "then": { "properties": { "contentId": { "type": "null" } } }
        }
      ]
    }
  }
}
